# WiFi MAC loader
type macloader, domain;
type macloader_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(macloader)

allow macloader mnt_vendor_file:dir r_dir_perms;
allow macloader mnt_vendor_file:file r_file_perms;

allow macloader vendor_convergence_data_file:file r_file_perms;
allow macloader vendor_convergence_data_file:dir search;

allow macloader vendor_sysfs_wifi:file rw_file_perms;

allow macloader mnt_vendor_file:dir { write add_name };
