# Fingerprint
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint-service\.samsung                  u:object_r:hal_fingerprint_default_exec:s0

# Camera
/(vendor|system/vendor)/bin/hw/android\.hardware\.camera\.provider-service\.samsung                         u:object_r:hal_camera_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.camera\.provider-service_32\.samsung                      u:object_r:hal_camera_default_exec:s0

# Light (AIDL Samsung service)
/(vendor|system/vendor)/bin/hw/android\.hardware\.light-service\.samsung                                   u:object_r:hal_light_default_exec:s0

# RIL sec-radio database
/data/vendor/secradio(/.*)?                                                                               u:object_r:vendor_radio_data_file:s0

# Samsung daemons
/vendor/bin/argosd                                                                                         u:object_r:argosd_exec:s0
/vendor/bin/hw/macloader                                                                                   u:object_r:macloader_exec:s0
/vendor/bin/secril_config_svc                                                                              u:object_r:secril_config_svc_exec:s0

# Samsung vibrator (AIDL service)
/(vendor|system/vendor)/bin/hw/android\.hardware\.vibrator-service\.samsung                                     u:object_r:hal_vibrator_default_exec:s0

# Fingerprint template storage
/data/vendor/biometrics(/.*)?                                                                              u:object_r:vendor_biometrics_data_file:s0

# Shared conn data (bt CID, wifi version)
/data/vendor/conn(/.*)?                                                                                    u:object_r:vendor_convergence_data_file:s0

# Samsung fingerprint sensor device
/dev/esfp[0-9]+                                                                                             u:object_r:fp_sensor_device:s0

# Samsung NFC
/(vendor|system/vendor)/bin/hw/android\.hardware\.nfc@1\.2-service\.samsung                                      u:object_r:hal_nfc_default_exec:s0
/dev/sec-nfc                                                                                                  u:object_r:nfc_device:s0

# Trustonic TEE daemons
/vendor/bin/hw/vendor\.trustonic\.tee@1\.0-service                                                             u:object_r:trustonic_tee_exec:s0
/vendor/bin/hw/vendor\.trustonic\.teeregistry@1\.0-service                                                     u:object_r:trustonic_teeregistry_exec:s0

# Modem SSR proxy
/vendor/bin/pm_proxy_helper                                                                                    u:object_r:pm_proxy_exec:s0
